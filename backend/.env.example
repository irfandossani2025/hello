# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gifting_crm
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=https://maiscrm.techittechnologies.com

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Get these from https://developers.facebook.com/apps/
WHATSAPP_VERIFY_TOKEN=gifting_crm_webhook_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v17.0
